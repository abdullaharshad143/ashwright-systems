# ─── Site ────────────────────────────────────────────────────────────────
# Public URL, used for metadata, sitemap, and Open Graph images.
# Optional on Vercel: falls back to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://ashwrightsystems.com

# ─── Supabase (lead storage) ─────────────────────────────────────────────
# Server-only. The service role key bypasses RLS; never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site content ────────────────────────────────────────────────────────
# Shared with the admin panel. It calls /api/revalidate with this after someone
# edits site content, so changes show up right away. Use a long random string,
# e.g. `openssl rand -hex 32`. Without it, edits still appear within an hour.
REVALIDATE_SECRET=

# ─── Resend (confirmation emails) ────────────────────────────────────────
RESEND_API_KEY=
# Must be a verified sender domain in Resend.
RESEND_FROM_EMAIL="Ashwright Systems <hello@ashwrightsystems.com>"
# Optional: internal address notified on every new lead.
LEAD_NOTIFICATION_EMAIL=
# Optional: admin panel URL, so the internal notification links straight to the lead.
ADMIN_URL=https://admin.ashwrightsystems.com

# ─── Cal.com ─────────────────────────────────────────────────────────────
# Event path from your Cal.com booking URL, e.g. cal.com/ashwright/intro
NEXT_PUBLIC_CAL_LINK=ashwright/intro

# ─── Meta (Pixel + Conversions API) ──────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only. Events Manager → Settings → Conversions API → Generate access token.
META_CAPI_ACCESS_TOKEN=
# Optional: set while validating in Events Manager → Test events.
META_CAPI_TEST_EVENT_CODE=

# ─── Google Analytics 4 (optional) ───────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
